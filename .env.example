# SignalInsight Configuration
# Database Connection (SQLite default, PostgreSQL compatible)
DATABASE_URL=sqlite:///./data/signalinsight.db

# API Server
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=false

# Allowed CORS Origins (JSON list or comma-separated strings)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173"]

# Storage Locations
FILE_STORAGE_PATH=./data/signals
DATASET_STORAGE_PATH=./data/datasets
MODEL_STORAGE_PATH=./data/models
REPORT_STORAGE_PATH=./data/reports
CACHE_PATH=./data/cache
