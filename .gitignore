# =====================================================================
# SignalInsight Runtime Caches, Projects & Generated Reports
# =====================================================================
.signalinsight_cache/
SignalInsight_Projects/
SignalInsight_Reports/
*.pdf
*.csv
# Retain any future reference documentation PDFs in docs/
!docs/**/*.pdf

# Database, datasets and raw storage
data/*.db
data/signals/*
data/cache/*
data/backups/*
data/datasets/*
data/radioml/*
*.pkl
*.h5
*.hdf5
*.tar.bz2
*.tar.gz
!data/models/amc_xgboost_v1.json

# =====================================================================
# Large RF Captures & Binary Recordings
# (Prevents multi-GB binary IQ dumps from bloating Git history)
# =====================================================================
*.iq
*.raw
*.bin
*.dat
*.cfile
*.sigmf-data

# Whitelist standard lightweight demo fixtures
!samples/demo_qpsk.wav

# =====================================================================
# Logs & Temporary Scratch Files
# =====================================================================
*.log
scratch/
crash_reports/

# =====================================================================
